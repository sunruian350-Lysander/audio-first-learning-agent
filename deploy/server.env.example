# Copy to .env.server in the project root. Compose reads it with --env-file.
# Never commit the real file. A public DNS hostname is required for public HTTPS.
ZOUMA_DOMAIN=learn.example.com
ZOUMA_USER=owner

# Required: run `docker run --rm -it caddy:2-alpine caddy hash-password`.
# Paste the hash inside SINGLE QUOTES to preserve its dollar signs.
# Leave no plaintext password here. Empty values prevent deployment.
ZOUMA_PASSWORD_HASH=''

# Safe default: demo mode makes no paid model requests.
AFL_PROVIDER=demo
AFL_API_BASE_URL=https://api.openai.com/v1
AFL_API_KEY=''
AFL_MODEL=''
AFL_JSON_MODE=false

# Configure voice separately when ready to test real microphone sessions.
AFL_VOICE_PROVIDER=disabled
AFL_REALTIME_API_BASE_URL=https://api.openai.com/v1
AFL_REALTIME_API_KEY=''
AFL_REALTIME_MODEL=gpt-realtime-2.1
AFL_REALTIME_VOICE=marin
AFL_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
