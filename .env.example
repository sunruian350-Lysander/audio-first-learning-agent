# Demo mode works without an API key and never makes model requests.
AFL_PROVIDER=demo

# To use a compatible Chat Completions endpoint, set the following in your shell.
# This file documents variables; the app does not automatically read .env files.
# AFL_PROVIDER=compatible
# AFL_API_BASE_URL=https://api.openai.com/v1
# AFL_API_KEY=your-own-key
# AFL_MODEL=your-provider-model-id
# AFL_JSON_MODE=false

# Optional directory for SQLite. Defaults to ./data; keep this private.
# AFL_DATA_DIR=./data

# Real voice is opt-in. This is independent of the course-generation provider.
# The app reads environment variables; this file is not loaded automatically.
# AFL_VOICE_PROVIDER=openai-realtime
# AFL_REALTIME_API_KEY=your-own-openai-key
# Or use OPENAI_API_KEY. AFL_API_KEY is never reused for voice automatically.
# AFL_REALTIME_API_BASE_URL=https://api.openai.com/v1
# AFL_REALTIME_MODEL=gpt-realtime-2.1
# AFL_REALTIME_VOICE=marin
# AFL_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# A configured real voice session sends microphone audio and lesson/discussion
# context to the provider and uses its paid API. Start it explicitly in the UI.
